# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# IDE
.vscode/

Add-Content .gitignore @'

# python
.venv/
__pycache__/
*.pyc

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# secrets
.env
*.pem

# data and build output
*.xlsx
*.parquet
*.zip
'@